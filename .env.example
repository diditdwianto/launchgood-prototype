# Backend configuration. Copy to `.env` in the repo root and fill in real values —
# `.env` is gitignored, this file is not.
#
# Loaded by the backend via python-dotenv (see backend/app/main.py), which reads
# both `backend/.env` and `../.env` — so this root file is the one that matters
# whether you run the backend from the repo root or from `backend/`.

# --- Model provider (required for the real pipeline; omit and the app runs on
# deterministic stubs instead) ---
groq_api_key=

# Fallback chain, fast first and durable last. Only models verified to support
# strict json_schema are accepted; the app refuses to start otherwise.
model_chain=openai/gpt-oss-20b,openai/gpt-oss-120b,openai/gpt-oss-safeguard-20b,nvidia/nemotron-3-super-120b-a12b

# Optional — enables the NVIDIA tail of the model_chain above. Limited per
# minute rather than per day, so it's what keeps a spent Groq quota degrading
# the demo to slow instead of broken.
nvidia_build_api_key=

# Optional — powers web_search for campaigns submitted through the app (the 14
# seeded fixtures always use canned results regardless of this key; that's a
# hard rule in code, not something this variable controls — see
# search_provider_for() in backend/app/agent/tools.py). Set it to get real
# search results on live submissions instead of "nothing found"; leave it
# unset if you want that path to stay network-free and deterministic too
# (e.g. right before recording a demo).
tavily_api_key=

# Optional — UK Charity Commission lookup. Inactive without a key.
charity_commission_key=

# --- Database (required) ---
# Local dev default matches docker-compose.yml. In production, use the managed
# Postgres URL (e.g. Render's Internal Database URL).
database_url=postgresql://trustcopilot:dev@localhost:55432/trustcopilot

# --- Auth ---
# Secret used to sign reviewer session tokens. Generate a real random value for
# any deployed environment — do not reuse this example.
auth_secret=

# --- CORS ---
# The exact origin(s) the frontend is served from, comma-separated, no trailing
# slash (e.g. https://campaign-trust-copilot.vercel.app). Defaults to `*` if
# unset, which works but is looser than necessary — see DEPLOY.md §3.
cors_origins=

# --- Dangerous — leave unset in any deployed environment ---
# Forces all 14 seed campaigns to re-run through the live model on every boot.
# Fine locally; in production it makes cold start depend on fourteen model
# calls landing inside a free-tier rate limit, which this design exists to avoid.
reassess_on_start=

# --- Rarely needed ---
# Percentage of campaigns held out from the AI recommendation, for the
# assisted/unassisted training split described on /under-the-hood. Defaults to 15.
unassisted_holdout_pct=
