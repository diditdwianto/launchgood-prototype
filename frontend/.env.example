# Frontend configuration. Copy to `.env.local` inside `frontend/` and fill in
# a real value — `.env.local` is gitignored, this file is not.

# The backend's host — wherever it actually lives: a Render service URL, a
# custom domain, or a bare VPS IP (e.g. http://203.0.113.10:8000). No trailing
# slash. Falls back to http://localhost:8000 if unset, which is fine for local
# dev against `uv run uvicorn app.main:app --port 8000`.
#
# This is inlined into the JS bundle at build time (the `NEXT_PUBLIC_` prefix
# is what does that), so changing it in a deployed environment requires a
# redeploy, not just a restart — see DEPLOY.md.
NEXT_PUBLIC_API_BASE=http://localhost:8000
